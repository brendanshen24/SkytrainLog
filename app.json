{
  "expo": {
    "name": "SkytrainDex",
    "slug": "SkytrainLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/skytraindex-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DC0A2D",
        "foregroundImage": "./assets/skytraindex-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/skytraindex-favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ]
  }
}
